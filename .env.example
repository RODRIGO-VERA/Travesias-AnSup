# === Travesías AnSup — Variables de entorno ===
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a un repositorio público.

# --- Supabase (obligatorio) ---
# Ver README.md → paso 1 para obtener estos valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Autenticación del panel administrativo ---
# Genera un hash con: npm run hash-password "tu-contraseña"
ADMIN_EMAIL=admin@travesiasansup.cl
ADMIN_PASSWORD_HASH=
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio

# --- WhatsApp ---
NEXT_PUBLIC_WHATSAPP_NUMBER=56912345678
# Etapa 2 — WhatsApp Business Cloud API
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Correo (etapa 2, para enviar aprobaciones por email) ---
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=reservas@travesiasansup.cl

# --- General ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/travesiasansup
